{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bitbucket": {
    "Workspace": "",
    "BaseUrl": "https://api.bitbucket.org/2.0/",
    "TimeoutSeconds": 30,
    "DefaultPageLength": 25,
    "OAuth": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4400"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4400"]
  },
  "Authorization": {
    "ProductionApprovedUsers": []
  },
  "Environments": [
    { "Id": "uat", "Name": "UAT", "RequiresExtraConfirmation": false },
    { "Id": "staging", "Name": "Staging", "RequiresExtraConfirmation": false },
    { "Id": "production", "Name": "Production", "RequiresExtraConfirmation": true }
  ],
  "ConnectionStrings": {
    "Deployments": "Data Source=App_Data/deployments.db"
  }
}
